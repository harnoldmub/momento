# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/momento"

# Secret used to sign admin session cookies (long random string, required)
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Public URL of the site, WITHOUT trailing slash (canonical links, sitemap, Google)
SITE_URL="https://www.momento-wedding.com"

# Optional: initial admin account created by `npm run db:seed` (only if no admin exists yet)
# ADMIN_EMAIL="admin@momento.rdc"
# ADMIN_PASSWORD="choose-a-strong-password"

# Optional: Google Search Console verification code (content of the meta tag)
# GOOGLE_SITE_VERIFICATION=""

# Optional: where admin uploads are stored (default: ./uploads, must be persistent)
# UPLOAD_DIR="/data/uploads"

# Optional: email notification for each booking request (https://resend.com)
# RESEND_API_KEY=""
# RESEND_FROM="Momento <contact@your-domain.com>"
# LEADS_TO_EMAIL="you@example.com"
